{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/programmes", "destination": "/#services", "permanent": true },
    { "source": "/approach", "destination": "/#approach", "permanent": true },
    { "source": "/work", "destination": "/#services", "permanent": true },
    { "source": "/about", "destination": "/", "permanent": true },
    { "source": "/contact", "destination": "/book", "permanent": true },
    { "source": "/ai-flix", "destination": "/", "permanent": true },
    { "source": "/blog", "destination": "/insights", "permanent": true },
    { "source": "/blog/:slug", "destination": "/insights/:slug", "permanent": true },
    { "source": "/pt/programas", "destination": "/pt#services", "permanent": true },
    { "source": "/pt/abordagem", "destination": "/pt#approach", "permanent": true },
    { "source": "/pt/trabalho", "destination": "/pt#services", "permanent": true },
    { "source": "/pt/sobre", "destination": "/pt", "permanent": true },
    { "source": "/pt/contacto", "destination": "/pt/marcar", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
