#!/bin/sh
# Refuses a push to main or master (on any remote) of commits that carry .no-merge-to-main,
# whether they arrived by merge, fast-forward, cherry-pick or a push of this branch onto main.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main|refs/heads/master) ;; *) continue ;; esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac     # a deletion
  if case "$remote_sha" in *[!0]*) false ;; *) true ;; esac; then
    range="$local_sha"                                     # new remote branch: check everything
  else
    range="$remote_sha..$local_sha"
  fi
  for sha in $(git rev-list "$range" 2>/dev/null || echo "$local_sha"); do
    if git cat-file -e "$sha:.no-merge-to-main" 2>/dev/null; then
      echo "pre-push: refused. Commit $sha carries .no-merge-to-main and must never reach ${remote_ref#refs/heads/}." >&2
      echo "Pushing to main deploys to production. If main was merged or fast-forwarded by mistake," >&2
      echo "move it back to the remote's commit before doing anything else." >&2
      status=1
      break
    fi
  done
done
exit $status
